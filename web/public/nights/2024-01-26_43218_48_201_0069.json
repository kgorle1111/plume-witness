acility_id":"110000461107","distance_km":1.0,"bearing_deg":90.2,"in_corridor":true,"resolution":"in the upwind corridor"}],"ongoing_incidents":[],"search_scope":"Searched every STEERS emissions event starting 01/26/2024 in Harris County (1 found; search complete). Also searched reports that started in the 30 days before and were still running (0 open that day; earlier search incomplete).","status":"search_incomplete","incident":null,"matched_facility_id":null,"source_url":"https://www2.tceq.texas.gov/oce/eer/","checks":[{"at":"T+24h","status":"search_incomplete","note":""},{"at":"T+14d","status":"search_incomplete","note":""}],"reported":null},"corridor":{"origin_site_id":"48_201_0069","half_width_deg":22.5,"max_km":15.0,"wind_from_deg":[49.0,101.0]},"packet":{"draft_en":"On January 26, 2024, the Texas state monitor at Houston Milby Park recorded 11.11 ppb of 1,3-butadiene in the 2:00 p.m. CST hour, against a 7-day median of 0.165 ppb. Wind there came from 101 degrees at 4.6 mph. 42 major permitted facilities lie in the upwind corridor. No matching report was found in the records checked; the search is incomplete. Requested follow-up: confirm whether any facility in this corridor reported a release that hour.","draft_es":"El 26 de enero de 2024, el monitor estatal de Texas en Houston Milby Park registró 11.11 ppb de 1,3-butadieno en la hora de las 2:00 p. m. CST, frente a una mediana de 7 días de 0.165 ppb. El viento venía de 101 grados a 4.6 mph. Hay 42 instalaciones permitidas importantes en el corredor de donde venía el viento. No se encontró un informe correspondiente en los registros revisados; la búsqueda está incompleta. Seguimiento solicitado: confirmar si alguna instalación en este corredor reportó una emisión a esa hora.","drafted_by":"template (deterministic, no AI)","guard":{"passed":true,"rejected":[]}},"cannot_say":["A matching report is not proof the facility caused every reading; other sources can add to a spike.","'Not yet reported' is not a finding about any facility: Texas requires a report only at or above a reportable quantity, and air readings cannot measure how much was released (30 TAC 101.201).","The upwind corridor comes from wind direction at one monitor (geometry only), not a dispersion model; it cannot tell facilities along the same bearing apart.","Facility coordinates are as published by EPA ECHO and may be approximate.","Only regulator-grade monitors whose data the state publishes are used (including two industry-funded Houston Regional Monitoring sites), never low-cost sensors."],"provenance":[{"file":"backtest/agc_2024_48_201_0069_43218.html","url":"https://www.tceq.texas.gov/cgi-bin/compliance/monops/agc_yearly_summary.pl","params":{"user_year":"2024","user_site":"48_201_0069","user_param":"43218","user_units":"ppb-v","report_format":"comma","user_decimals":"2"},"bytes":87894,"sha256":"2375f9582494c8511986eacd0c1eb65559bd314ab3162542923d26f3713455d9","fetched_at":"2026-11-14T23:58:38+00:00"},{"file":"backtest/agc_2024_48_201_0307_43218.html","url":"https://www.tceq.texas.gov/cgi-bin/compliance/monops/agc_yearly_summary.pl","params":{"user_year":"2024","user_site":"48_201_0307","user_param":"43218","user_units":"ppb-v","report_format":"comma","user_decimals":"2"},"bytes":87841,"sha256":"ad09b44f1ba973e847620c1f993365d24266d9be9f7241ceaea5668feb85fa1e","fetched_at":"2026-11-14T23:58:59+00:00"},{"file":"backtest/agc_2024_48_201_0057_43218.html","url":"https://www.tceq.texas.gov/cgi-bin/compliance/monops/agc_yearly_summary.pl","params":{"user_year":"2024","user_site":"48_201_0057","user_param":"43218","user_units":"ppb-v","report_format":"comma","user_decimals":"2"},"bytes":88599,"sha256":"6be3f73caa0dc50df94586cd86d20a4e81fd1d4d7dddc4afda2326ef91a6ea39","fetched_at":"2026-11-14T23:59:22+00:00"},{"file":"backtest/agc_2024_48_201_1614_43218.html","url":"https://www.tceq.texas.gov/cgi-bin/compliance/monops/agc_yearly_summary.pl","params":{"user_year":"2024","user_site":"48_201_1614","user_param":"4