dline","note":""},{"at":"T+14d","status":"no_report_after_deadline","note":""}],"reported":null,"day_incidents":[],"search_scope":"Searched every STEERS emissions event starting 05/04/2024 in Harris County (0 found; search complete). No matching report found in a complete search."},"corridor":{"origin_site_id":"48_201_0069","half_width_deg":22.5,"max_km":15.0,"wind_from_deg":[91.0,114.0]},"packet":{"draft_en":"On May 4, 2024, the Texas state monitor at Houston Milby Park recorded 32.25 ppb of 1,3-butadiene in the 4:00 a.m. CST hour, against a 7-day median of 2.95 ppb. Wind there came from 114 degrees at 5.4 mph. 31 major permitted facilities lie in the upwind corridor. No matching report found in a complete search of that day's emissions-event records for Harris County. That does not show who or what caused the reading. Requested follow-up: confirm whether any facility in this corridor reported a release that hour.","draft_es":"El 4 de mayo de 2024, el monitor estatal de Texas en Houston Milby Park registró 32.25 ppb de 1,3-butadieno en la hora de las 4:00 a. m. CST, frente a una mediana de 7 días de 2.95 ppb. El viento venía de 114 grados a 5.4 mph. Hay 31 instalaciones permitidas importantes en el corredor de donde venía el viento. No se encontró un informe correspondiente en una búsqueda completa de los registros de eventos de emisiones de ese día en el condado de Harris. Eso no indica quién o qué causó la lectura. Seguimiento solicitado: confirmar si alguna instalación en este corredor reportó una emisión a esa hora.","drafted_by":"template (deterministic, no AI)","guard":{"passed":true,"rejected":[]}},"cannot_say":["A matching report is not proof the facility caused every reading; other sources can add to a spike.","'Not yet reported' would not mean 'illegal': Texas requires a report only above a reportable quantity, and air readings cannot measure how much was released (30 TAC 101.201).","The upwind corridor comes from wind direction at one monitor (geometry only), not a dispersion model; it cannot tell facilities along the same bearing apart.","Facility coordinates are as published by EPA ECHO and may be approximate.","Only regulator-grade state monitors are used; many neighborhoods have none."],"provenance":[{"file":"backtest/agc_2024_48_201_0069_43218.html","url":"https://www.tceq.texas.gov/cgi-bin/compliance/monops/agc_yearly_summary.pl","params":{"user_year":"2024","user_site":"48_201_0069","user_param":"43218","user_units":"ppb-v","report_format":"comma","user_decimals":"2"},"bytes":87894,"sha256":"2375f9582494c8511986eacd0c1eb65559bd314ab3162542923d26f3713455d9","fetched_at":"2026-11-14T23:58:38+00:00"},{"file":"backtest/agc_2024_48_201_0307_43218.html","url":"https://www.tceq.texas.gov/cgi-bin/compliance/monops/agc_yearly_summary.pl","params":{"user_year":"2024","user_site":"48_201_0307","user_param":"43218","user_units":"ppb-v","report_format":"comma","user_decimals":"2"},"bytes":87841,"sha256":"ad09b44f1ba973e847620c1f993365d24266d9be9f7241ceaea5668feb85fa1e","fetched_at":"2026-11-14T23:58:59+00:00"},{"file":"backtest/agc_2024_48_201_0057_43218.html","url":"https://www.tceq.texas.gov/cgi-bin/compliance/monops/agc_yearly_summary.pl","params":{"user_year":"2024","user_site":"48_201_0057","user_param":"43218","user_units":"ppb-v","report_format":"comma","user_decimals":"2"},"bytes":88599,"sha256":"6be3f73caa0dc50df94586cd86d20a4e81fd1d4d7dddc4afda2326ef91a6ea39","fetched_at":"2026-11-14T23:59:22+00:00"},{"file":"backtest/agc_2024_48_201_1614_43218.html","url":"https://www.tceq.texas.gov/cgi-bin/compliance/monops/agc_yearly_summary.pl","params":{"user_year":"2024","user_site":"48_201_1614","user_param":"43218","user_units":"ppb-v","report_format":"comma","user_decimals":"2"},"bytes":88561,"sha256":"9de26668f41f2d5315ff143717872224a5dccf73e85ffbe8c1e39db4cd4d1227","fetched_at":"2026-11-14T23:59:45+00:00"},{"file":"backtest/agc_2024_48_201_1035_43218.html","url":"https://www.tceq.texas.gov/cgi-bin/compliance/monops/a