":"110012710423","name":"Air Products Baytown Plant","lat":29.769488,"lon":-95.025308,"distance_km":14.9,"bearing_deg":42.5,"alignment":0.991,"in_corridor":true,"source":"EPA ECHO (major emissions source)","coord_precision":"as published by ECHO","rank":30},{"id":"110000463123","name":"Eco Services Operations","lat":29.748056,"lon":-95.003556,"distance_km":14.9,"bearing_deg":54.7,"alignment":0.941,"in_corridor":true,"source":"EPA ECHO (major emissions source)","coord_precision":"as published by ECHO","rank":31}],"record_check":{"day_incidents":[{"incident":"436684","entity":"ExxonMobil Baytown Refinery","rn":"RN102579307","start_local":"2025-02-22T03:00","compound":"Benzene","pounds":220.0,"facility_id":"110000502901","distance_km":14.1,"bearing_deg":57.1,"in_corridor":true,"resolution":"in the upwind corridor"},{"incident":"436679","entity":"Houston Refining","rn":"RN100218130","start_local":"2025-02-22T08:21","compound":"1-Butene","pounds":141.0,"facility_id":"110058113704","distance_km":11.2,"bearing_deg":294.5,"in_corridor":false,"resolution":"outside the corridor (11.2 km, 99° off the wind)"}],"ongoing_incidents":[{"incident":"430265","entity":"Cedar Bayou Hydrogen Facility","rn":"RN111509147","start_local":"2024-09-30T12:00","compound":"CO","pounds":10174.92,"facility_id":null,"distance_km":null,"bearing_deg":null,"in_corridor":null,"resolution":"unresolved: facility not located"}],"search_scope":"Searched every STEERS emissions event starting 02/22/2025 in Harris County (2 found; search complete). Also searched reports that started in the 30 days before and were still running (1 open that day; earlier search complete).","status":"reported_mismatch","incident":"436684","matched_facility_id":"110000502901","source_url":"https://www2.tceq.texas.gov/oce/eer/index.cfm?fuseaction=main.getDetails&target=436684","checks":[{"at":"T+24h","status":"reported","note":"initial notice filed 2025-02-22T20:03 local, 17.1 h after the reported discovery 2025-02-22T03:00"},{"at":"T+14d","status":"reported","note":"final report dated 2025-03-07, 10 days after the event ended"}],"compound_match":false,"reported":{"facility":"ExxonMobil Baytown Refinery","compound":"Benzene","pounds":220.0,"start_local":"2025-02-22T03:00","end_local":"2025-02-25T00:59","tz":"local (CST)","cause":"A leak at the sample point led to a benzene spill to soil with air emissions at OMCC","match_basis":"started near the spike","travel_h":2.43,"travel_speed_mph":3.6,"travel_distance_km":14.1,"start_to_spike_h":16.0,"arrival_local":"2025-02-22T05:26","spike_hour_local":["2025-02-22T19:00","2025-02-22T20:00"]}},"corridor":{"origin_site_id":"48_201_1039","half_width_deg":22.5,"max_km":15.0,"wind_from_deg":[34.0,36.0]},"packet":{"draft_en":"On February 22, 2025, the Texas state monitor at Houston Deer Park #2 recorded 10.38 ppb of 1,3-butadiene in the 7:00 p.m. CST hour, against a 7-day median of 0.025 ppb. Wind there came from 36 degrees at 3.6 mph. 31 major permitted facilities lie in the upwind corridor. One of them, ExxonMobil Baytown Refinery, filed report 436684 for a release that started at 03:00 that day and, per the report, ran until 2025-02-25 00:59 local time, but the report does not list 1,3-butadiene, so it does not match this reading. Requested follow-up: confirm what caused this 1,3-butadiene reading.","draft_es":"El 22 de febrero de 2025, el monitor estatal de Texas en Houston Deer Park #2 registró 10.38 ppb de 1,3-butadieno en la hora de las 7:00 p. m. CST, frente a una mediana de 7 días de 0.025 ppb. El viento venía de 36 grados a 3.6 mph. Hay 31 instalaciones grandes con permiso en el corredor viento arriba. Una de ellas, ExxonMobil Baytown Refinery, presentó el reporte 436684 por una emisión que empezó a las 03:00 ese día y que, según el reporte, siguió hasta el 2025-02-25 00:59, hora local, pero el reporte no incluye 1,3-butadieno, así que no corresponde a esta lectura. Seguimiento solicitado: confirmar qué causó esta lectura de 1,3-butadieno.","drafted_by":"template (deterministic, no AI)","guard":{"passed":true,"rejected":[]}},"cannot_say":["A matching report is not proof the facility caused every reading; other sources can add to a spike.","'Not yet reported' is not a finding about any facility: Texas requires a report only at or above a reportable quantity, and air readings cannot measure how much was released (30 TAC 101.201).","The upwind corridor comes from wind direction at one monitor (geometry only), not a dispersion model; it cannot tell facilities along the same bearing apart.","Facility coordinates are as published by EPA ECHO and may be approximate.","Only regulator-grade monitors whose data the state publishes are used (including two industry-funded Houston Regional Monitoring sites), never low-cost sensors."],"provenance":[{"file":"backtest/agc_2025_48_201_0069_43218.html","url":"https://www.tceq.texas.gov/cgi-bin/compliance/monops/agc_yearly_summary.pl","params":{"user_year":"2025","user_site":"48_201_0069","user_param":"43218","user_units":"ppb-v","report_format":"comma","user_decimals":"2"},"bytes":87615,"sha256":"70b693fcc10d18c2a81516df45e5655308a04dc9766ca598260e9d68d478372b","fetched_at":"2026-11-14T23:58:48+00:00"},{"file":"backtest/agc_2025_48_201_0307_43218.html","url":"https://www.tceq.texas.gov/cgi-bin/compliance/monops/agc_yearly_summary.pl","params":{"user_year":"2025","user_site":"48_201_0307","user_param":"43218","user_units":"ppb-v","report_format":"comma","user_decimals":"2"},"bytes":88649,"sha256":"0a17f200bfc5578973f8861ebafc67558bbe6d4e401f1cf1925822be0bbdbec1","fetched_at":"2026-11-14T23:59:11+00:00"},{"file":"backtest/agc_2025_48_201_0057_43218.html","url":"https://www.tceq.texas.gov/cgi-bin/compliance/monops/agc_yearly_summary.pl","params":{"user_year":"2025","user_site":"48_201_0057","user_param":"43218","user_units":"ppb-v","report_format":"comma","user_decimals":"2"},"bytes":88034,"sha256":"25c2cf6eb93814b3ba415f246fca5eb5304c964cec008621d793ef6ff36646ea","fetched_at":"