y be approximate.","Hours when all seven compounds the analyzer reports read 5 ppb or more at once are the analyzer's check gas and are not counted.","Only South Coast AQMD's Rule 1180 community monitors are used, never low-cost sensors.","The wind used here was measured at an airport weather station, not at the monitor that flagged the spike, so the upwind direction there may differ."],"provenance":[{"file":"region_los_angeles/1hr_q4_2021.zip","url":"https://www.aqmd.gov/docs/default-source/compliance/rule-1180/generated-on-july-27-2023---files-for-data-download/2021/q4/1hr_q4_2021.zip?sfvrsn=e855b661_2","params":null,"bytes":578937,"sha256":"2d8734baed0b40793b43b9263a05846dffdd69169c28c21eba367205dc32d325","fetched_at":"2026-11-15T16:50:19+00:00"},{"file":"region_los_angeles/r1180_portal.html","url":"https://xappprod.aqmd.gov/Rule1180CommunityAirMonitoring/","params":null,"bytes":62502,"sha256":"d85ee6a4fb3f36b9f79c468a4b0098d648a33f38d2b4a88bcccc38194756e1d5","fetched_at":"2026-11-15T16:52:54+00:00"},{"file":"region_los_angeles/asos_HHR_202110_202212.csv","url":"https://mesonet.agron.iastate.edu/cgi-bin/request/asos.py?station=HHR&data=drct&data=sknt&year1=2021&month1=10&day1=1&year2=2022&month2=12&day2=1&tz=Etc%2FGMT%2B8&format=onlycomma&latlon=yes&missing=M&report_type=3","params":null,"bytes":510304,"sha256":"3e1fd8784ec807d83d60c63fdaa084534cd6040124b61986a2ee77aa87186f1f","fetched_at":"2026-11-15T17:25:34+00:00"},{"file":"region_los_angeles/echo_r1180_GUEN_10mi.json","url":"https://echodata.epa.gov/echo/air_rest_services.get_qid","params":{"output":"JSON","p_lat":"33.8705","p_long":"-118.3134","p_radius":"10","p_act":"Y","qid":"857","pageno":"1"},"bytes":240602,"sha256":"4ebbc9b6b4dca09dff4bc63d059e88a27fa26c771781c5611aecc565df1a44b8","fetched_at":"2026-11-15T17:26:40+00:00"},{"file":"region_los_angeles/nrc_la_2021_2022.json","url":null,"params":null,"bytes":483940,"sha256":"b2093481da2e25ab4255e648b1a9ed3d88831b4f6fa9e7e7864e312dc9ce21be","fetched_at":null